{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libs-microarca.traceedu.com.br/schemas/blocks.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "package": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "maxLength": 32
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "category": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "name",
        "color"
      ],
      "additionalProperties": false
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "fields": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{0,31}$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "identifier",
                    "integer",
                    "text",
                    "value",
                    "dropdown"
                  ]
                },
                "default": {},
                "min": {
                  "type": "integer"
                },
                "max": {
                  "type": "integer"
                },
                "options": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  }
                }
              },
              "required": [
                "name",
                "type",
                "default"
              ],
              "additionalProperties": false
            }
          },
          "python": {
            "type": "object",
            "properties": {
              "imports": {
                "type": "array",
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "template": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2000
              }
            },
            "required": [
              "imports",
              "template"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "name",
          "description",
          "label",
          "fields",
          "python"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "package",
    "category",
    "blocks"
  ],
  "additionalProperties": false
}
