{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libs-microarca.traceedu.com.br/schemas/catalog.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "maxLength": 32
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "homepage": {
            "type": "string",
            "maxLength": 2048
          },
          "compatibility": {
            "type": "object",
            "properties": {
              "micropython": {
                "type": "string",
                "pattern": "^>=1\\.[0-9]+(?:\\.[0-9]+)?$"
              },
              "boards": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z0-9_]+$"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "micropython",
              "boards"
            ],
            "additionalProperties": false
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "maxLength": 64
                },
                "version": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
                  "maxLength": 32
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            },
            "uniqueItems": true
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z_0-9]*\\.py$",
                  "maxLength": 128
                },
                "url": {
                  "type": "string",
                  "pattern": "^packages/[a-z0-9-]+/[0-9]+\\.[0-9]+\\.[0-9]+/[A-Za-z_0-9.]+$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65536
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "name",
                "url",
                "size",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "license_url": {
            "type": "string",
            "pattern": "^packages/[a-z0-9-]+/[0-9]+\\.[0-9]+\\.[0-9]+/[A-Za-z_0-9.]+$"
          },
          "provenance_url": {
            "type": "string",
            "pattern": "^packages/[a-z0-9-]+/[0-9]+\\.[0-9]+\\.[0-9]+/[A-Za-z_0-9.]+$"
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "description",
          "author",
          "license",
          "homepage",
          "compatibility",
          "dependencies",
          "files",
          "license_url"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema",
    "packages"
  ],
  "additionalProperties": false
}
